<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>PURPOSE: Send one test HTML email with Insert from URL (cURL over SMTP)</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Settings - edit these before running</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["mail.example.com"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$smtpserver</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["smtp-username@example.com"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$smtpaccount</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["ENTER PASSWORD HERE"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$smtppass</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["survey@mcservices.com"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$from</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["duane@mcservices.com"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$to</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["HTML email test " & Get ( CurrentTimestamp )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$subject</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Body - any HTML works here</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["<html><body style='margin:0;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif;'>" & ¶ &
"<table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='background:#f3f4f6;padding:24px 0;'><tr><td align='center'>" & ¶ &
"<table role='presentation' width='600' cellpadding='0' cellspacing='0' style='max-width:600px;width:100%;background:#ffffff;'>" & ¶ &
"<tr><td style='background:#0f2a4a;color:#ffffff;padding:20px 28px;font-size:20px;font-weight:bold;'>HTML Email Test</td></tr>" & ¶ &
"<tr><td style='padding:24px 28px;font-size:15px;color:#111827;'>" & ¶ &
"<p>If you can see a <b>dark blue header</b>, <span style='color:#dc2626;'>red text</span> and the button below, HTML email is working.</p>" & ¶ &
"<p>Sent from FileMaker at " & Get ( CurrentTimestamp ) & " by " & Get ( AccountName ) & ".</p>" & ¶ &
"<p><a href='https://mcservices.com' style='display:inline-block;background:#1d4ed8;color:#ffffff;text-decoration:none;font-weight:bold;padding:10px 20px;'>Test link</a></p>" & ¶ &
"</td></tr>" & ¶ &
"</table></td></tr></table></body></html>"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$html</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Build the MIME message - SMTP needs CR+LF line endings</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Let ( [
  b = "MCS_TEST_BOUNDARY" ;
  msg =
   "From: MC Services <" & $from & ">" & ¶ &
   "To: " & $to & ¶ &
   "Subject: " & $subject & ¶ &
   "MIME-Version: 1.0" & ¶ &
   "Content-Type: multipart/alternative; boundary=\"" & b & "\"" & ¶ & ¶ &
   "--" & b & ¶ &
   "Content-Type: text/plain; charset=UTF-8" & ¶ &
   "Content-Transfer-Encoding: 8bit" & ¶ & ¶ &
   "HTML email test. If you are reading this plain text, your mail app did not show the HTML part." & ¶ & ¶ &
   "--" & b & ¶ &
   "Content-Type: text/html; charset=UTF-8" & ¶ &
   "Content-Transfer-Encoding: 8bit" & ¶ & ¶ &
   $html & ¶ & ¶ &
   "--" & b & "--" & ¶
] ;
  Substitute ( msg ; ¶ ; Char ( 13 ) & Char ( 10 ) )
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$message</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["--mail-from " & Quote ( $from ) &
" --mail-rcpt " & Quote ( $to ) &
" --user " & Quote ( $smtpaccount & ":" & $smtppass ) &
" --ssl-reqd" &
" --upload-file $message"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$curl</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Send - port 587 is STARTTLS, so smtp:// plus --ssl-reqd</Text>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="160" name="Insert from URL">
    <NoInteract state="True"/>
    <DontEncodeURL state="False"/>
    <SelectAll state="True"/>
    <VerifySSLCertificates state="True"/>
    <CURLOptions>
      <Calculation><![CDATA[$curl]]></Calculation>
    </CURLOptions>
    <Calculation><![CDATA["smtp://" & $smtpserver & ":587"]]></Calculation>
    <Text/>
    <Field>$result</Field>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[List ( Get ( LastError ) ; Get ( LastExternalErrorDetail ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$error</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[GetValue ( $error ; 1 ) <> 0]]></Calculation>
  </Step>
  <Step enable="True" id="87" name="Show Custom Dialog">
    <Title>
      <Calculation><![CDATA["Send failed"]]></Calculation>
    </Title>
    <Message>
      <Calculation><![CDATA["FileMaker error: " & GetValue ( $error ; 1 ) & ¶ &
"Detail: " & GetValue ( $error ; 2 ) & ¶ &
"Server said: " & $result]]></Calculation>
    </Message>
    <Buttons>
      <Button CommitState="True">
        <Calculation><![CDATA["OK"]]></Calculation>
      </Button>
    </Buttons>
  </Step>
  <Step enable="True" id="69" name="Else">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="87" name="Show Custom Dialog">
    <Title>
      <Calculation><![CDATA["Test email sent"]]></Calculation>
    </Title>
    <Message>
      <Calculation><![CDATA["Sent to " & $to & ¶ & "Subject: " & $subject]]></Calculation>
    </Message>
    <Buttons>
      <Button CommitState="True">
        <Calculation><![CDATA["OK"]]></Calculation>
      </Button>
    </Buttons>
  </Step>
  <Step enable="True" id="70" name="End If"/>
</fmxmlsnippet>
