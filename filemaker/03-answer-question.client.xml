<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>Stop if this survey is already completed - prevents a double-click from adding answers or sending the email twice</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Survey::Status = "Completed"]]></Calculation>
  </Step>
  <Step enable="True" id="103" name="Exit Script"/>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Check for Answer</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $$answer)]]></Calculation>
  </Step>
  <Step enable="True" id="87" name="Show Custom Dialog">
    <Title>
      <Calculation><![CDATA["Please Select an Answer"]]></Calculation>
    </Title>
    <Message>
      <Calculation><![CDATA["Please Select an Answer"]]></Calculation>
    </Message>
    <Buttons>
      <Button CommitState="True">
        <Calculation><![CDATA["OK"]]></Calculation>
      </Button>
      <Button CommitState="False">
        <Calculation><![CDATA["Cancel"]]></Calculation>
      </Button>
      <Button CommitState="False"/>
    </Buttons>
  </Step>
  <Step enable="True" id="103" name="Exit Script"/>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Go to Answers Layout to enter answer</Text>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="SelectedLayout"/>
    <Layout id="29" name="Answers"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Create new record for answer</Text>
  </Step>
  <Step enable="True" id="7" name="New Record/Request"/>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$$currentquestion]]></Calculation>
    <Field table="Answers" id="7" name="QuestionID"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$$SurveyID]]></Calculation>
    <Field table="Answers" id="6" name="SurveyID"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$$answer]]></Calculation>
    <Field table="Answers" id="9" name="SelectedAnswer"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Set Score based on Answer</Text>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[Case (
$$answer=1 ;
Survey_CurrentQuestion::Score1 ;
$$answer=2 ;
Survey_CurrentQuestion::Score2;
$$answer=3 ;
Survey_CurrentQuestion::Score3;
$$answer=4 ;
Survey_CurrentQuestion::Score4;
 0 )]]></Calculation>
    <Field table="Answers" id="10" name="Score"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Enter Recommendation based on Answer Response - blank, not 0, when no answer matches</Text>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[Case (
$$answer=1 ;
Survey_CurrentQuestion::Recommendation1 ;
$$answer=2 ;
Survey_CurrentQuestion::Recommendation2;
$$answer=3 ;
Survey_CurrentQuestion::Recommendation3 ;
$$answer=4 ;
Survey_CurrentQuestion::Recommendation4;
 "" )]]></Calculation>
    <Field table="Answers" id="13" name="Recommendation"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Enter Response in Answers</Text>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$$Response]]></Calculation>
    <Field table="Answers" id="12" name="Response"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>put Question in Answer Record</Text>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$$QuestionText]]></Calculation>
    <Field table="Answers" id="14" name="Question"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[Get ( CurrentTimestamp )]]></Calculation>
    <Field table="Answers" id="4" name="AnsweredAt"/>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
    <Restore state="True"/>
    <Query>
      <RequestRow operation="Include">
        <Criteria>
          <Field table="Survey" id="1" name="SurveyID"/>
          <Text>$$SurveyID</Text>
        </Criteria>
      </RequestRow>
    </Query>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Survey::CalculatedTotalScore]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$$TotalScore</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="75" name="Commit Records/Requests">
    <NoInteract state="True"/>
    <Option state="False"/>
    <ESSForceCommit state="False"/>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="OriginalLayout"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[Survey::CurrentQuestion+1]]></Calculation>
    <Field table="Survey" id="12" name="CurrentQuestion"/>
  </Step>
  <Step enable="False" id="74" name="Go to Related Record">
    <Option state="False"/>
    <MatchAllRecords state="False"/>
    <ShowInNewWindow state="False"/>
    <Restore state="True"/>
    <LayoutDestination value="SelectedLayout"/>
    <NewWndStyles Style="Document" Close="Yes" Minimize="Yes" Maximize="Yes" Resize="Yes" Styles="3606018"/>
    <Table id="1065102" name="Survey_CurrentQuestion"/>
    <Layout id="28" name="Questions"/>
  </Step>
  <Step enable="True" id="80" name="Refresh Window">
    <Option state="False"/>
    <FlushSQLData state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Last question answered - score the survey and send the email (Complete Survey hands the send to the server)</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Survey::CurrentQuestion>10]]></Calculation>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Script id="1" name="Complete Survey"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[""]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$$answer</Name>
  </Step>
</fmxmlsnippet>
