<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>PURPOSE: Run the whole Constant Contact sync in the order that keeps both sides right:</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>1. Import contacts (links people, records unsubscribes)  2. Import lists (list changes made in Constant Contact set the boxes)  3. Push (box changes made in FileMaker go to Constant Contact)</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Start on a CONSTANTC layout.</Text>
  </Step>
  <Step enable="True" id="85" name="Allow User Abort">
    <Set state="False"/>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Get ( LayoutName )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$Layout</Name>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Script id="0" name="Import Constant Contact Contacts"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Get ( ScriptResult )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$contacts</Name>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="LayoutNameByCalc"/>
    <Layout>
      <Calculation><![CDATA[$Layout]]></Calculation>
    </Layout>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$$PluginStatus <> 1]]></Calculation>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[0]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="1" name="Perform Script">
    <Script id="0" name="Import Constant Contact Lists"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Get ( ScriptResult )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$lists</Name>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="LayoutNameByCalc"/>
    <Layout>
      <Calculation><![CDATA[$Layout]]></Calculation>
    </Layout>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$lists <> 1]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>The list import already said what went wrong. Pushing now could undo changes made in Constant Contact, so stop.</Text>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[0]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA["silent"]]></Calculation>
    <Script id="0" name="Push Contacts to Constant Contact"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Get ( ScriptResult )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$push</Name>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="LayoutNameByCalc"/>
    <Layout>
      <Calculation><![CDATA[$Layout]]></Calculation>
    </Layout>
  </Step>
  <Step enable="True" id="87" name="Show Custom Dialog">
    <Title>
      <Calculation><![CDATA["Constant Contact"]]></Calculation>
    </Title>
    <Message>
      <Calculation><![CDATA["Contacts updated from Constant Contact: " & GetValue ( $contacts ; 1 ) & ¶ &
"New contacts from Constant Contact: " & GetValue ( $contacts ; 2 ) & ¶ &
"Created in Constant Contact: " & JSONGetElement ( $push ; "created" ) & ¶ &
"Added to a list from FileMaker: " & JSONGetElement ( $push ; "added" ) & ¶ &
"Removed from a list from FileMaker: " & JSONGetElement ( $push ; "removed" ) &
If ( not IsEmpty ( JSONGetElement ( $push ; "skipped" ) ) ; ¶ & ¶ & "Not done:" & ¶ & JSONGetElement ( $push ; "skipped" ) )]]></Calculation>
    </Message>
    <Buttons>
      <Button CommitState="True">
        <Calculation><![CDATA["OK"]]></Calculation>
      </Button>
      <Button CommitState="False"/>
      <Button CommitState="False"/>
    </Buttons>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[JSONGetElement ( $push ; "ok" )]]></Calculation>
  </Step>
</fmxmlsnippet>
