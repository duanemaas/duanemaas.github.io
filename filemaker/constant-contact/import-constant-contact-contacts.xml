    <Query>
      <RequestRow operation="Include">
        <Criteria>
          <Field table="CONTACTINFO" id="4" name="Information"/>
          <Text>==$email</Text>
        </Criteria>
      </RequestRow>
    </Query>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not IsEmpty ( $email ) and Get ( FoundCount ) ≠ 0]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$Modified + 1]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
