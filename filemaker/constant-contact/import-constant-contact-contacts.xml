<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>PURPOSE: Import contacts changed in Constant Contact since the last sync, using the v3 API with Insert from URL (cURL). Replaces the plug-in version.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>RETURNS: modified count ¶ added count. Start on a CONSTANTC layout.</Text>
  </Step>
  <Step enable="True" id="85" name="Allow User Abort">
    <Set state="False"/>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Make sure the access token is current, then read it while still on CONSTANTC</Text>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Script id="0" name="Check Constant Contact Connection"/>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$$PluginStatus <> 1]]></Calculation>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[0 & ¶ & 0]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetField ( "CONSTANTC::CC_AccessToken" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$accessToken</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>updated_after wants ISO 8601 in UTC. LastSyncTime is used as-is if it already is, otherwise converted from a local timestamp. Empty = every contact.</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Let ( [
  raw = CONSTANTC::LastSyncTime ;
  offset = Round ( ( Get ( CurrentTimestamp ) - GetAsTimestamp ( Floor ( Get ( CurrentTimeUTCMilliseconds ) / 1000 ) ) ) / 900 ; 0 ) * 900 ;
  utc = GetAsTimestamp ( raw ) - offset ;
  d = GetAsDate ( utc ) ;
  t = GetAsTime ( utc )
] ;
  Case (
    IsEmpty ( raw ) ; "" ;
    PatternCount ( raw ; "T" ) ; raw ;
    Year ( d ) & "-" & Right ( "0" & Month ( d ) ; 2 ) & "-" & Right ( "0" & Day ( d ) ; 2 ) & "T" &
    Right ( "0" & Hour ( t ) ; 2 ) & ":" & Right ( "0" & Minute ( t ) ; 2 ) & ":" & Right ( "0" & Int ( Seconds ( t ) ) ; 2 ) & "Z"
  )
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$since</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["https://api.cc.email/v3/contacts?status=all&limit=500" &
If ( not IsEmpty ( $since ) ; "&updated_after=" & GetAsURLEncoded ( $since ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$url</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["--request GET" &
" --header " & Quote ( "Authorization: Bearer " & $accessToken ) &
" --header " & Quote ( "Accept: application/json" ) &
" --dump-header $headers"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$curl</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$Modified</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$Added</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Outer loop: one page of up to 500 contacts per request</Text>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="160" name="Insert from URL">
    <NoInteract state="True"/>
    <DontEncodeURL state="True"/>
    <SelectAll state="True"/>
    <VerifySSLCertificates state="True"/>
    <CURLOptions>
      <Calculation><![CDATA[$curl]]></Calculation>
    </CURLOptions>
    <Calculation><![CDATA[$url]]></Calculation>
    <Text/>
    <Field>$json</Field>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[List ( Get ( LastError ) ; Get ( LastExternalErrorDetail ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$error</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Let ( [
  pos = Position ( $headers ; "HTTP/" ; Length ( $headers ) ; -1 ) ;
  line = Middle ( $headers ; pos ; 40 ) ;
  sp = Position ( line ; " " ; 1 ; 1 )
] ;
  GetAsNumber ( Middle ( line ; sp + 1 ; 3 ) )
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$httpCode</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[GetValue ( $error ; 1 ) <> 0 or $httpCode <> 200]]></Calculation>
  </Step>
  <Step enable="True" id="87" name="Show Custom Dialog">
    <Title>
      <Calculation><![CDATA["Constant Contact"]]></Calculation>
    </Title>
    <Message>
      <Calculation><![CDATA["The contact import stopped early." & ¶ &
"FileMaker error: " & GetValue ( $error ; 1 ) & " " & GetValue ( $error ; 2 ) & ¶ &
"HTTP status: " & $httpCode & ¶ &
"Server said: " & Left ( $json ; 500 )]]></Calculation>
    </Message>
    <Buttons>
      <Button CommitState="True">
        <Calculation><![CDATA["OK"]]></Calculation>
      </Button>
      <Button CommitState="False"/>
      <Button CommitState="False"/>
    </Buttons>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[True]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$failed</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[$failed]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ValueCount ( JSONListKeys ( $json ; "contacts" ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$count</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Inner loop: one contact</Text>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[$i >= $count]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $json ; "contacts[" & $i & "]" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$contact</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$i + 1]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $contact ; "contact_id" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$ContactID</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $contact ; "email_address.address" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$email</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $contact ; "first_name" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$firstName</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $contact ; "last_name" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$lastName</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Trim ( $firstName & " " & $lastName )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$ContactName</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $contact ; "updated_at" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$lastUpdateTime</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[List ( $importList ; $ContactID )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$importList</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Check if Contact exists by CC ID if it does then updates the Contact Status.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>If not, searches by Contact Name, then by Email, to see if it's in the system.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>If not creates a new record with CC info.</Text>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="SelectedLayout"/>
    <Layout id="304" name="CONTACTS"/>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
    <Restore state="True"/>
    <Query>
      <RequestRow operation="Include">
        <Criteria>
          <Field table="CONTACTS" id="39" name="_fk_ConstantContactID"/>
          <Text>==$ContactID</Text>
        </Criteria>
      </RequestRow>
    </Query>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Get ( FoundCount ) ≠ 0]]></Calculation>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[Case( Sum(contact_ccsubscribers_CCLIST::Flag_Active) > 0 ; "Active" ;
          Sum( contact_ccsubscribers_CCLIST::Flag_DoNotMail ) > 0 ; "Do Not Mail" ;
         Sum( contact_ccsubscribers_CCLIST::Flag_Removed ) > 0 ; "Removed" ; "" )]]></Calculation>
    <Field table="CONTACTS" id="48" name="CC_Status"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$lastUpdateTime]]></Calculation>
    <Field table="CONTACTS" id="40" name="CC_LastUpdateTime"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$Modified + 1]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$Modified</Name>
  </Step>
  <Step enable="True" id="69" name="Else">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Not linked yet. Try the name - skipped when Constant Contact has no name, so a blank never matches.</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$nameMatches</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not IsEmpty ( $ContactName )]]></Calculation>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
    <Restore state="True"/>
    <Query>
      <RequestRow operation="Include">
        <Criteria>
          <Field table="CONTACTS" id="11" name="NameFull_c"/>
          <Text>==$ContactName</Text>
        </Criteria>
      </RequestRow>
    </Query>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Get ( FoundCount )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$nameMatches</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$nameMatches ≠ 0]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$Modified + 1]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$Modified</Name>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$ContactID]]></Calculation>
    <Field table="CONTACTS" id="39" name="_fk_ConstantContactID"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[Case( Sum(contact_ccsubscribers_CCLIST::Flag_Active) > 0 ; "Active" ;
          Sum( contact_ccsubscribers_CCLIST::Flag_DoNotMail ) > 0 ; "Do Not Mail" ;
         Sum( contact_ccsubscribers_CCLIST::Flag_Removed ) > 0 ; "Removed" ; "" )]]></Calculation>
    <Field table="CONTACTS" id="48" name="CC_Status"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$lastUpdateTime]]></Calculation>
    <Field table="CONTACTS" id="40" name="CC_LastUpdateTime"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[CONTACTS::__pk_Contact ID]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$ContactIDNumber</Name>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="SelectedLayout"/>
    <Layout id="323" name="CONTACTINFO"/>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
    <Restore state="True"/>
    <Query>
      <RequestRow operation="Include">
        <Criteria>
          <Field table="CONTACTINFO" id="2" name="_fk_Entity_ID"/>
          <Text>==$ContactIDNumber</Text>
        </Criteria>
        <Criteria>
          <Field table="CONTACTINFO" id="4" name="Information"/>
          <Text>==$email</Text>
        </Criteria>
      </RequestRow>
    </Query>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Get ( FoundCount ) = 0]]></Calculation>
  </Step>
  <Step enable="True" id="7" name="New Record/Request"/>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$ContactIDNumber]]></Calculation>
    <Field table="CONTACTINFO" id="2" name="_fk_Entity_ID"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$email]]></Calculation>
    <Field table="CONTACTINFO" id="4" name="Information"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["E-Mail"]]></Calculation>
    <Field table="CONTACTINFO" id="3" name="Type"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[1]]></Calculation>
    <Field table="CONTACTINFO" id="32" name="flag_ConstantContactEmail"/>
  </Step>
  <Step enable="True" id="69" name="Else">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[1]]></Calculation>
    <Field table="CONTACTINFO" id="32" name="flag_ConstantContactEmail"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="69" name="Else">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>No name match. Try the email address on its own.</Text>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="SelectedLayout"/>
    <Layout id="323" name="CONTACTINFO"/>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
