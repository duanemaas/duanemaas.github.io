    <Title>
      <Calculation><![CDATA["Constant Contact"]]></Calculation>
    </Title>
    <Message>
      <Calculation><![CDATA["Could not set " & $flagField & " (FileMaker error " & Max ( $setError ; Get ( LastError ) ) & "). Check the field name at the top of this script."]]></Calculation>
    </Message>
    <Buttons>
      <Button CommitState="True">
        <Calculation><![CDATA["OK"]]></Calculation>
      </Button>
      <Button CommitState="False"/>
      <Button CommitState="False"/>
    </Buttons>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[True]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$failed</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$marked + 1]]></Calculation>
