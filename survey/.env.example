# Copy this file to .env and fill in your FileMaker Server details.
# .env is git-ignored; never commit real credentials.

# Host name or IP of FileMaker Server, e.g. fms.example.com or 192.168.1.20 (add :port if not 443).
FM_HOST=filemaker.example.local

# Hosted file name, without the .fmp12 extension.
FM_DATABASE=Survey

# Layout the survey reads and writes. Every field on it becomes a question.
FM_LAYOUT=Survey_Web

# A FileMaker account whose privilege set has the "fmrest" extended privilege.
# Give it access to the survey layout only.
FM_USER=web_survey
FM_PASSWORD=change-me

# Optional: comma-separated field names to limit which layout fields the form shows.
FM_FIELDS=

# Set to true only if FileMaker Server still uses its default self-signed certificate.
FM_ALLOW_SELF_SIGNED=false

# Local port for the survey app.
PORT=3000
